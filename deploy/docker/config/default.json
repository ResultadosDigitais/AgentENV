{
  "log_level": "info",
  "log_format": "auto",
  "scheduler": {
    "grpc_listen_addr": ":9090",
    "strategy": "round_robin",
    "report_ttl": "30s",
    "binding_ttl": "30s",
    "nodes": [
      {
        "id": "node-a",
        "endpoint": "http://agentenv-a:8000"
      },
      {
        "id": "node-b",
        "endpoint": "http://agentenv-b:8000"
      }
    ],
    "node_resource_limit": {
      "memory_capacity_source": "total",
      "shape_admission": "on",
      "admission_layers": [
        {"memory_gb": 8},
        {"memory_gb": 16},
        {"memory_gb": 32},
        {"memory_gb": 64}
      ]
    }
  },
  "gateway": {
    "http_listen_addr": ":8080",
    "scheduler_addr": "scheduler:9090",
    "request_timeout": "90s",
    "forward_response_size": 4194304,
    "sandbox_proxy_domains": []
  }
}
